{
  "name": "@myriaddreamin/typst.vue3",
  "version": "0.8.0-rc4",
  "type": "module",
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    },
    "./libertinus": {
      "types": "./dist/types/libertinus.d.ts",
      "import": "./dist/libertinus.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite -c vite.config.dev.ts",
    "build:types": "vue-tsc -p tsconfig.type.json && node scripts/resolve-declaration-imports.mjs",
    "build": "vite build && vite build --mode umd && vite build --mode fonts && yarn build:types",
    "test": "playwright test",
    "test:tar": "playwright test --config playwright.tar.config.ts",
    "publish:dry": "npm publish --dry-run --access public",
    "publish:lib": "npm publish --access public || exit 0"
  },
  "peerDependencies": {
    "@myriaddreamin/typst-ts-renderer": "0.8.0-rc4",
    "@myriaddreamin/typst-ts-web-compiler": "0.8.0-rc4",
    "@myriaddreamin/typst.ts": "0.8.0-rc4",
    "vue": "3.5.17"
  },
  "devDependencies": {
    "@myriaddreamin/typst-ts-renderer": "0.8.0-rc4",
    "@myriaddreamin/typst-ts-web-compiler": "0.8.0-rc4",
    "@myriaddreamin/typst.ts": "0.8.0-rc4",
    "@vitejs/plugin-vue": "5.2.4",
    "playwright": "1.65.1",
    "typescript": "5.8.3",
    "vue": "3.5.17",
    "vue-tsc": "2.2.12"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Myriad-Dreamin/typst.ts"
  }
}
